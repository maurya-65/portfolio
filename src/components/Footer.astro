---
import { site } from "../data/site";
---

<footer class="footer">
  <div class="footer-top">
    <nav class="footer-links" aria-label="Footer">
      <a href="#about">About</a>
      <a href="#works">Works</a>
      <a href="#services">Services</a>
      <a href={site.github} target="_blank" rel="noopener">GitHub</a>
      <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
    </nav>
    <div class="footer-contact">
      <a href={`tel:${site.phone.replace(/\s/g, "")}`}>{site.phone}</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <address>
        Address:<br />
        {site.address.map((line) => <>{line}<br /></>)}
      </address>
    </div>
  </div>

  <p class="footer-wordmark" aria-hidden="true">
    <span>{site.firstName} {site.lastName}</span>
  </p>

  <div class="footer-bar">
    <span>Fredericton, Canada &nbsp;|&nbsp; <time data-clock={site.location.timeZone}>--:--</time></span>
    <span>© {new Date().getFullYear()} {site.firstName} {site.lastName}</span>
  </div>
</footer>
