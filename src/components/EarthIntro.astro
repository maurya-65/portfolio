---
import { site } from "../data/site";
---

<section
  class="earth-intro"
  aria-label="Introduction"
  data-lat={site.location.lat}
  data-lon={site.location.lon}
>
  <div class="earth-stage">
    <canvas class="earth-canvas" aria-hidden="true"></canvas>
    <div class="earth-veil" aria-hidden="true"></div>
    <p class="earth-hint" aria-hidden="true">
      <span>Scroll</span>
      <i></i>
    </p>
  </div>
</section>

<noscript>
  <style>
    .earth-intro {
      display: none;
    }
  </style>
</noscript>
