---
import { site, footer } from "../../data/site";
import Roll from "../ui/Roll.astro";

const name = `${site.firstName} ${site.lastName}`.toLowerCase();
---

<footer class="footer" id="footer">
  <div class="container">
    <div class="footer__wrapper">
      <a href={`tel:${site.phoneHref}`} class="footer-phone footer-line-animation">{site.phone}</a>
      <a href={`mailto:${site.email}`} class="footer-email footer-line-animation" data-copy={site.email}>{site.email}</a>
      <div class="footer__social">
        <a href={site.instagram} target="_blank" rel="noopener noreferrer" class="link-line">instagram</a>
        <a href={site.github} target="_blank" rel="noopener noreferrer" class="link-line">github</a>
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="link-line">linkedin</a>
      </div>
      <div class="footer-pages-location">
        <div class="footer-pages">
          {footer.pages.map((page) => <Roll text={page.label} anchor={page.id} />)}
        </div>
        <div class="footer-location">
          <p>Address:</p>
          <p>{site.address[0]}<br />{site.address[1]}</p>
        </div>
      </div>
      <div class="footer-behance">
        {footer.links.map((link) => <Roll text={link.label} href={link.href} target={link.href === "#" ? undefined : "_blank"} />)}
      </div>
      <h2 class="footer-title" aria-label={name}>{[...name].map((char) => <span aria-hidden="true">{char === " " ? " " : char}</span>)}</h2>
      <div class="footer-reserved">
        <div class="footer-reserved__time">
          <div class="kyiv-clock" data-clock={site.location.timeZone}>
            <h2>{site.basedIn.toLowerCase()}, canada:</h2>
            <p data-clock-time></p>
          </div>
        </div>
        <a href="https://olhalazarieva.com/" class="footer-reserved__dev" target="_blank" rel="noreferrer" aria-label="Reference: Olha Lazarieva">ref - <span class="ref-name"><span>ol</span><span>olha lazarieva</span></span></a>
        <div class="footer-reserved__reserved">© {site.year} {site.firstName} {site.lastName}</div>
      </div>
    </div>
  </div>
</footer>
<div class="copy-tooltip"><span>Copied</span></div>
