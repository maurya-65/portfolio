---
import { site, contact } from "../data/site";
import Split from "./Split.astro";
import Arrow from "./Arrow.astro";
---

<section class="form" id="connect">
  <div class="container">
    <div class="form__wrapper">
      <h3 class="form-title-top">{contact.kicker}</h3>
      <Split text={contact.headline[0]} class="form-title" />
      <h3 class="form-title-middle">{contact.between}</h3>
      <Split text={contact.headline[1]} class="form-title" />
    </div>
    <form data-contact-form data-mailto={site.email} action="#" method="POST" accept-charset="UTF-8">
      <div class="form-fields">
        <input type="text" name="name" placeholder="your name*" autocomplete="name" required />
        <input type="tel" name="phone" placeholder="phone*" autocomplete="tel" inputmode="tel" required pattern="^\+[0-9()\-\s]{6,}$" title="Start with +, then digits, spaces, ( ) - (min 7 chars)" />
        <input type="email" name="email" placeholder="your email*" autocomplete="email" required />
        <textarea name="message" placeholder="How can I help you" required></textarea>
        <h4>{contact.legend}</h4>
        <div class="budget">
          <div class="budget__wrapper">
            {contact.topics.map((topic, index) => (
              <label class={index === 0 ? "is-active-radio" : undefined}>
                <input type="radio" name="topic" value={topic.value} required checked={index === 0} />
                <span>{topic.label}</span>
              </label>
            ))}
          </div>
        </div>
      </div>
      <button class="link-line" type="submit">{contact.submit}<Arrow stroke="#101010" /></button>
    </form>
  </div>
</section>
