---
import { achievements } from "../data/site";
import Letters from "./Letters.astro";

const [start, joiner, strong] = achievements.lead;
const [top, detail, edition] = achievements.note;
---

<section class="achievements">
  <div class="ach-head">
    <h2 class="ach-title"><Letters text={achievements.title} /></h2>
    <span class="ach-code">{achievements.code}</span>
  </div>
  <p class="ach-lead">{start}<br />{joiner} <strong>{strong}</strong></p>
  <p class="ach-note"><strong>{top}</strong><br />{detail}<br />{edition}</p>
  <ul class="ach-list">
    {achievements.items.map((item) => (
      <li>
        <a href={item.href}>
          <span class="ach-name">{item.name}{item.year && <sup>'{item.year}</sup>}</span>
          <i aria-hidden="true">↗</i>
        </a>
      </li>
    ))}
  </ul>
</section>
