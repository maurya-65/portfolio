---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Works from "../components/Works.astro";
import LaptopShowcase from "../components/LaptopShowcase.astro";
import Services from "../components/Services.astro";
import Education from "../components/Education.astro";
import Timeline from "../components/Timeline.astro";
import { experience, achievements } from "../data/site";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<Base>
  <div class="App">
    <div class="scroll-container">
      <Header />
      <div class="site" id="home">
        <Hero />
        <div class="dark-zone">
          <About />
          <Works />
        </div>
        <LaptopShowcase />
        <Services />
        <Timeline id="experience" {...experience} />
        <Timeline id="achievements" {...achievements} />
        <Education />
        <Contact />
        <Footer />
      </div>
    </div>
  </div>
</Base>
