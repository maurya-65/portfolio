---
import "@fontsource/sofia-sans-condensed/600.css";
import "@fontsource/sofia-sans-condensed/700.css";
import "@fontsource/spline-sans-mono/300.css";
import "@fontsource/spline-sans-mono/400.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import { site } from "../data/site";

interface Props {
  title?: string;
}

const { title = `${site.firstName} ${site.lastName} | ${site.role}` } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`Portfolio of ${site.firstName} ${site.lastName}, ${site.role}.`} />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
  </head>
  <body>
    <canvas class="space" aria-hidden="true"></canvas>
    <Header />
    <main>
      <slot />
    </main>
    <script>
      import "../scripts/space.ts";
      import "../scripts/site.ts";
      import "../scripts/earth-intro.ts";
      import "../scripts/laptop.ts";
    </script>
  </body>
</html>
