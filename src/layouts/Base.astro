---
import "../styles/global.css";
import "../styles/components.css";
import { site } from "../data/site";

interface Props {
  title?: string;
}

const { title = `${site.firstName} ${site.lastName} · ${site.role}` } = Astro.props;
const description = `${site.firstName} ${site.lastName} is a computer science student and software developer in ${site.basedIn}, building fast, clear web software.`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href="/fonts/sofia-bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/spline-light.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <script is:inline>
      // A reload always starts at the top: turn off the browser's scroll restore before first paint.
      if ("scrollRestoration" in history) history.scrollRestoration = "manual";
      window.scrollTo(0, 0);
      window.addEventListener("pagehide", () => window.scrollTo(0, 0));
    </script>
  </head>
  <body>
    <div class="loader" id="loader" role="status" aria-label="Loading">
      <span class="loader-counter" aria-hidden="true"><span data-loader-count>0</span>%</span>
    </div>
    <slot />
    <script>
      // site.ts loads the two 3D sections itself and keeps the loader up until they are drawn.
      import "../scripts/main.ts";
    </script>
  </body>
</html>
