---
import Base from "../layouts/Base.astro";
import Roll from "../components/Roll.astro";
---

<Base title="Page not found">
  <section class="not-found">
    <div class="container">
      <div class="not-found__wrapper">
        <h2>This page has paused</h2>
        <p>Perhaps it got lost on the way here</p>
        <h3>Try starting again</h3>
        <Roll text="return home" href="/" />
      </div>
    </div>
  </section>
</Base>
