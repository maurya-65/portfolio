---
import "../styles/olha.css";
import "../styles/extras.css";
import { site } from "../data/site";

interface Props {
  title?: string;
}

const { title = `${site.firstName} ${site.lastName} · ${site.role}` } = Astro.props;
const description = `${site.firstName} ${site.lastName} is a computer science student and software developer in ${site.basedIn}, building fast, clear web software.`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href="/fonts/sofia-bold.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/spline-light.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/textures/earth/blue-marble-2k.webp" as="image" type="image/webp" fetchpriority="high" />
    <title>{title}</title>
  </head>
  <body>
    <canvas class="space" aria-hidden="true"></canvas>
    <slot />
    <script>
      import "../scripts/space.ts";
      import "../scripts/site.ts";
      import "../scripts/earth-intro.ts";
      import "../scripts/laptop.ts";
      import "../scripts/works.ts";
    </script>
  </body>
</html>
